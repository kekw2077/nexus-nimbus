    <item>
      <title>Nexus Nimbus 0.3.0</title>
      <pubDate>Mon, 07 Sep 2026 16:43:37 +0000</pubDate>
      <sparkle:version>0.3.0</sparkle:version>
      <sparkle:shortVersionString>0.3.0</sparkle:shortVersionString>
      <description><![CDATA[
        <style>
          html,body{background:#07080C;color:#C7CBD6;margin:0;padding:14px 18px;
            font-family:'Segoe UI',Roboto,sans-serif;font-size:14px;line-height:1.5;}
